/* 有页 · 全局样式
 * 颜色取自图标：米色桌面、奶油纸页、墨绿封皮、赤陶印章。
 */
page {
  --desk: #F6E3C7;
  --paper: #FCF0DA;
  --paper-hi: #FFF8E9;
  --line: #EBDABB;
  --line-2: #DDC9A4;
  --green: #30533A;
  --green-deep: #254230;
  --green-soft: #9DB89F;
  --green-wash: #DDE6D2;
  --terra: #C96F43;
  --terra-soft: #EDBFA4;
  --mustard: #DDA63F;
  --ink: #2B382E;
  --ink-2: #6F6A57;
  --ink-3: #A69E88;
  --sans: "PingFang SC", "HarmonyOS Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", system-ui, sans-serif;
  --numerals: "Avenir Next", Roboto, "Helvetica Neue", Arial, sans-serif;
  --editorial: Georgia, "Noto Serif", serif;
  --serif: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  --shadow: 0 6rpx 22rpx rgba(96, 66, 28, 0.13);

  background: var(--desk);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, image, input, textarea, scroll-view, button {
  box-sizing: border-box;
}

/* 普通的整页容器 */
.tab-page {
  min-height: 100vh;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.serif {
  font-family: var(--serif);
}

/* 纸页卡片 */
.paper {
  background: var(--paper);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
}

/* CSS 小箭头 */
.chev {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid var(--ink-2);
  border-right: 4rpx solid var(--ink-2);
  border-radius: 2rpx;
}
.chev.l { transform: rotate(-135deg); margin-left: 6rpx; }
.chev.r { transform: rotate(45deg); margin-right: 6rpx; }

/* 圆形小按钮（翻月、翻日） */
.round-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.round-btn:active { background: rgba(48, 83, 58, 0.1); }

/* 胶囊标签 */
.chip {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: var(--green);
  background: var(--green-wash);
}

/* 主按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--paper);
  background: var(--green);
}
.btn:active { background: var(--green-deep); }
.btn.ghost {
  color: var(--green);
  background: transparent;
  border: 2rpx solid var(--green);
}

/* 底部抽屉 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
  background: rgba(43, 56, 46, 0.32);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s;
}
.mask.show {
  opacity: 1;
  pointer-events: auto;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(96, 66, 28, 0.16);
  transform: translateY(105%);
  transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.sheet.show {
  transform: translateY(0);
}
.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 4rpx;
  background: var(--line-2);
}
.sheet-title {
  margin-bottom: 20rpx;
  font-family: var(--serif);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

/* 「限免 / 会员」小角标 */
.tag {
  display: inline-block;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--paper);
  background: var(--terra);
}
