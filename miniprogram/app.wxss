/* 有页 · 全局样式
 * 手帐配色：浅灰桌面、白纸与炭灰墨色。
 */
page {
  --desk: #EBEBEB;
  --paper: #FAFAFA;
  --paper-hi: #FFFFFF;
  --line: #DEDEDE;
  --line-2: #C7C7C7;
  --accent: #262626;
  --accent-deep: #141414;
  --accent-soft: #BDBDBD;
  --accent-wash: #EAEAEA;
  --emphasis: #424242;
  --ink: #202020;
  --ink-2: #535353;
  --ink-3: #666666;
  --sans: "PingFang SC", "HarmonyOS Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", system-ui, sans-serif;
  --numerals: "Avenir Next", Roboto, "Helvetica Neue", Arial, sans-serif;
  --editorial: Georgia, "Noto Serif", serif;
  --radius-control: 10px;
  --radius-card: 17px;
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 5px 14px rgba(0, 0, 0, 0.08);

  background: var(--desk);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, image, input, textarea, scroll-view, button {
  box-sizing: border-box;
}

/* 普通的整页容器 */
.tab-page {
  min-height: 100vh;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

/* 纸页卡片 */
.paper {
  background: var(--paper);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow);
}

/* CSS 小箭头 */
.chev {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--ink-2);
  border-right: 3rpx solid var(--ink-2);
  border-radius: 2rpx;
}
.chev.l { transform: rotate(-135deg); margin-left: 6rpx; }
.chev.r { transform: rotate(45deg); margin-right: 6rpx; }

/* 圆形小按钮（翻月、翻日） */
.round-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.round-btn:active { background: rgba(26, 26, 26, 0.1); }

/* 快捷选项 */
.chip {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-control);
  font-size: 24rpx;
  color: var(--accent);
  background: var(--accent-wash);
}

/* 首页贴纸夹与日页抽屉共用分类标签 */
.sticker-tab {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8px 8px 0 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-2);
}
.sticker-tab.on {
  color: var(--accent);
  font-weight: 500;
  background: #E4E4E4;
}

/* 主按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-control);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--paper);
  background: var(--accent);
}
.btn:active { background: var(--accent-deep); }
.btn.ghost {
  color: var(--accent);
  background: transparent;
  border: 2rpx solid var(--accent);
}

/* 底部抽屉 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
  background: rgba(20, 20, 20, 0.32);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s;
}
.mask.show {
  opacity: 1;
  pointer-events: auto;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
  transform: translateY(105%);
  transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.sheet.show {
  transform: translateY(0);
}
.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 4rpx;
  background: var(--line-2);
}
.sheet-title {
  margin-bottom: 20rpx;
  font-family: var(--sans);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

/* 「限免 / 会员」小角标 */
.tag {
  display: inline-block;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--paper);
  background: var(--emphasis);
}
