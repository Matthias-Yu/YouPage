.top {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx 28rpx;
  background: var(--desk);
}
.top-t {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1.4rpx;
  line-height: 1.2;
  color: var(--ink);
}
.top-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.body {
  padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom));
}
.beta {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}
.beta-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--emphasis);
}
.beta-tx {
  font-size: 24rpx;
  color: var(--ink-2);
}
.list {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}
.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.item:last-child {
  border-bottom: 0;
}
.item-ic {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.14));
}
.item-tx {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}
.item-hd {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}
.item-t {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}
.soon {
  flex-shrink: 0;
  padding: 0 12rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--ink-2);
  background: var(--accent-wash);
}
.item-d {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--ink-2);
}
.note {
  display: block;
  margin: 24rpx 8rpx 32rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--ink-3);
}
