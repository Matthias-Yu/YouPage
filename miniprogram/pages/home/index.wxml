<view class="top" style="height:{{topH}}px">
  <view class="masthead" style="top:{{navTop}}px">
    <asset-image image-class="masthead-mark" src="/assets/logo.png" mode="aspectFit" />
    <text class="masthead-name">有页</text>
    <text wx:if="{{!ready}}" class="masthead-status">正在加载…</text>
    <text wx:elif="{{ink}}" class="masthead-status">月历笔记</text>
    <text wx:elif="{{pickingDay}}" class="masthead-status">点日期添加照片</text>
    <text wx:elif="{{toolsOpen}}" class="masthead-status">单指绘画 · 双指缩放</text>
    <text wx:elif="{{open}}" class="masthead-status">点日期写字</text>
  </view>
</view>

<!-- 3D 场景 -->
<canvas
  type="webgl"
  id="gl"
  class="gl"
  style="top:{{topH}}px;height:{{glH}}px"
  disable-scroll
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchCancel"
></canvas>

<!-- 贴纸夹和底部菜单与 WebGL 画布分开 -->
<view wx:if="{{!ink}}" class="panel" style="height:{{panelH}}px;padding-bottom:{{safeBottom}}px">
  <!-- 第一次打开：先请用户看隐私政策 -->
  <view wx:if="{{consentAsk}}" class="consent">
    <text class="c-t">欢迎来到有页</text>
    <view class="c-p">
      <text>你写下的内容和贴上的照片会保存在这台手机上；同意后还会同步到云端，换手机也能找回。使用前请阅读</text>
      <text class="c-a" data-doc="privacy" bindtap="openLegal">《隐私政策》</text>
      <text>和</text>
      <text class="c-a" data-doc="terms" bindtap="openLegal">《用户协议》</text>
      <text>。</text>
    </view>
    <view class="c-btns">
      <button class="c-btn c-no" bindtap="declineConsent">不同意</button>
      <button
        id="agree-btn"
        class="c-btn c-ok"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="agreeConsent"
        bindtap="agreeConsent"
      >同意并开始</button>
    </view>
    <text class="c-s">不同意也可以使用，内容只保存在这台手机上。</text>
  </view>
  <view wx:elif="{{palette}}" class="ink-palette">
    <view class="palette-heading">
      <text class="palette-title">自定义颜色</text>
      <view class="palette-preview" style="background-color: {{palette.hex}}"></view>
      <text class="palette-hex">{{palette.hex}}</text>
    </view>
    <view id="ink-color-field" class="palette-field" style="background-color: hsl({{palette.h}}, 100%, 50%)" catchtouchstart="changeColorField" catchtouchmove="changeColorField" aria-label="调节饱和度与明度">
      <view class="palette-cursor" style="left: {{palette.s * 100}}%; top: {{(1 - palette.v) * 100}}%; background-color: {{palette.hex}}"></view>
    </view>
    <view class="palette-hue">
      <slider min="0" max="360" value="{{palette.h}}" activeColor="transparent" backgroundColor="transparent" block-size="16" aria-label="色相" bindchanging="changeHue" bindchange="changeHue" />
    </view>
    <view class="palette-footer">
      <button class="palette-cancel" bindtap="closePalette">取消</button>
      <button class="palette-apply" bindtap="applyPalette">使用此颜色</button>
    </view>
  </view>
  <view wx:else class="menu-layout">
    <view class="menu-panels">
    <view wx:if="{{tray}}" class="tray">
      <view class="tray-tabs">
        <view wx:for="{{packs}}" wx:key="id" class="tray-tab {{packIdx === index ? 'on' : ''}}" data-i="{{index}}" bindtap="switchPack">{{item.name}}</view>
      </view>
      <view class="tray-items">
        <view
          wx:for="{{items}}"
          wx:key="k"
          class="tray-item {{item.wide ? 'wide' : ''}}"
          hover-class="tray-item-hover"
          data-t="{{item.t}}"
          data-k="{{item.k}}"
          catchtouchstart="trayStart"
          catchtouchmove="trayMove"
          catchtouchend="trayEnd"
          catchtouchcancel="trayEnd"
        >
          <asset-image wx:if="{{item.src}}" image-class="tray-img" src="{{item.src}}" mode="aspectFit" />
          <view wx:else class="tray-tape" style="{{item.css}}"></view>
        </view>
      </view>
      <view wx:if="{{trayPages > 1}}" class="tray-pager">
        <view class="tray-arrow {{trayPage === 0 ? 'muted' : ''}}" data-n="-1" bindtap="shiftTray" role="button" aria-label="上一页贴纸" aria-disabled="{{trayPage === 0}}"><view class="chev l"></view></view>
        <text>{{trayPage + 1}} / {{trayPages}}</text>
        <view class="tray-arrow {{trayPage + 1 === trayPages ? 'muted' : ''}}" data-n="1" bindtap="shiftTray" role="button" aria-label="下一页贴纸" aria-disabled="{{trayPage + 1 === trayPages}}"><view class="chev r"></view></view>
      </view>
    </view>

    <view wx:if="{{toolsOpen}}" class="drawing-tools">
      <view class="drawing-row drawing-primary">
        <view class="drawing-pens">
          <view wx:for="{{drawTools}}" wx:key="id" class="drawing-key {{!pickingDay && brush === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="selectBrush" role="button" aria-label="{{item.name + (!pickingDay && brush === item.id ? '，已选中' : '')}}" hover-class="drawing-pressed">
            <asset-image image-class="drawing-glyph" src="{{'/assets/icons/drawing/' + item.id + '.svg'}}" mode="aspectFit" preview-local />
          </view>
          <view class="drawing-key {{pickingDay ? 'chosen' : ''}}" bindtap="pickCropDay" role="button" aria-label="{{pickingDay ? '照片裁切，已选中' : '照片裁切'}}" hover-class="drawing-pressed">
            <asset-image image-class="drawing-glyph" src="/assets/icons/drawing/crop.svg" mode="aspectFit" preview-local />
          </view>
        </view>
        <view class="drawing-actions">
          <view class="drawing-key {{!canUndo ? 'dimmed' : ''}}" bindtap="undoInk" role="button" aria-label="撤销" aria-disabled="{{!canUndo}}" hover-class="{{canUndo ? 'drawing-pressed' : 'none'}}">
            <asset-image image-class="drawing-glyph" src="/assets/icons/drawing/undo.svg" mode="aspectFit" preview-local />
          </view>
          <view class="drawing-key {{!canRedo ? 'dimmed' : ''}}" bindtap="redoInk" role="button" aria-label="重做" aria-disabled="{{!canRedo}}" hover-class="{{canRedo ? 'drawing-pressed' : 'none'}}">
            <asset-image image-class="drawing-glyph drawing-redo" src="/assets/icons/drawing/undo.svg" mode="aspectFit" preview-local />
          </view>
          <view class="drawing-key" bindtap="resetCalendarZoom" role="button" aria-label="还原月历视图" hover-class="drawing-pressed">
            <asset-image image-class="drawing-glyph" src="/assets/icons/drawing/fit.svg" mode="aspectFit" preview-local />
          </view>
          <view class="drawing-key {{!canClear ? 'dimmed' : ''}}" bindtap="clearInk" role="button" aria-label="清空本月笔迹" aria-disabled="{{!canClear}}" hover-class="{{canClear ? 'drawing-pressed' : 'none'}}">
            <asset-image image-class="drawing-glyph" src="/assets/icons/drawing/clear.svg" mode="aspectFit" preview-local />
          </view>
        </view>
      </view>
      <view class="drawing-row drawing-options">
        <view class="ink-colors {{brush === 'eraser' || pickingDay ? 'dimmed' : ''}}">
          <view wx:for="{{colors}}" wx:key="value" class="swatch {{color === item.value ? 'picked' : ''}}" style="--swatch: {{item.value}}" data-color="{{item.value}}" role="button" aria-label="{{item.name}}" aria-disabled="{{brush === 'eraser' || pickingDay}}" bindtap="selectColor"><view class="swatch-dot"></view></view>
          <view class="swatch" bindtap="openPalette" role="button" aria-label="打开自定义色盘" aria-disabled="{{brush === 'eraser' || pickingDay}}" hover-class="drawing-pressed">
            <asset-image image-class="palette-glyph" src="/assets/icons/drawing/palette.svg" mode="aspectFit" preview-local />
          </view>
        </view>
        <view class="ink-weights {{pickingDay ? 'dimmed' : ''}}">
          <view wx:for="{{weights}}" wx:key="*this" class="size-btn {{weight === index ? 'chosen' : ''}}" data-i="{{index}}" bindtap="selectWeight" role="button" aria-disabled="{{pickingDay}}" aria-label="{{item + '笔触' + (weight === index ? '，已选中' : '')}}">
            <view class="weight-mark" style="height: {{2 + index * 2}}px"></view>
          </view>
        </view>
      </view>
    </view>

    </view>
    <view class="month-rail">
      <block wx:if="{{open}}">
        <view class="rail-side" bindtap="toggleOpen" hover-class="control-pressed" role="button">合上</view>
        <view class="month-picker">
          <view class="month-arrow" data-n="-1" bindtap="shiftMonth" hover-class="control-pressed" role="button" aria-label="上个月"><view class="chev l"></view></view>
          <view class="month-label">
            <text class="month-number">{{m}}</text><text>月</text>
            <text class="month-year">{{y}}</text>
          </view>
          <view class="month-arrow" data-n="1" bindtap="shiftMonth" hover-class="control-pressed" role="button" aria-label="下个月"><view class="chev r"></view></view>
        </view>
        <view wx:if="{{!isThisMonth}}" class="rail-side rail-today" bindtap="goToday" hover-class="control-pressed" role="button">今天</view>
        <view wx:else class="rail-side"></view>
      </block>
      <view wx:else class="open-book" bindtap="openBook" hover-class="control-pressed" role="button">
        <text>打开手帐</text><view class="chev r"></view>
      </view>
    </view>

    <view class="dock">
      <view class="dock-item {{tray || toolsOpen ? '' : 'is-active'}}" bindtap="showBook" hover-class="control-pressed" role="button">
        <view class="dock-icon"><asset-image image-class="dock-img" src="/assets/icons/book.svg" mode="aspectFit" preview-local /></view>
        <text>手帐</text>
      </view>
      <view class="dock-item {{tray ? 'is-active' : ''}}" bindtap="toggleTray" hover-class="control-pressed" role="button" aria-label="{{tray ? '收起贴纸' : '打开贴纸'}}">
        <view class="dock-icon"><asset-image image-class="dock-img" src="/assets/icons/sticker.svg" mode="aspectFit" preview-local /></view>
        <text>贴纸</text>
      </view>
      <view class="dock-item {{toolsOpen ? 'is-active' : ''}}" bindtap="toggleTools" hover-class="control-pressed" role="button" aria-label="{{toolsOpen ? '收起工具' : '打开工具'}}">
        <view class="dock-icon"><asset-image image-class="dock-img" src="/assets/icons/pencil.svg" mode="aspectFit" preview-local /></view>
        <text>工具</text>
      </view>
      <view class="dock-item" bindtap="goHabits" hover-class="control-pressed" role="button">
        <view class="dock-icon"><asset-image image-class="dock-img" src="/assets/icons/seal.svg" mode="aspectFit" preview-local /></view>
        <text>打卡</text>
      </view>
      <view class="dock-item" bindtap="goMe" hover-class="control-pressed" role="button">
        <view class="dock-icon"><asset-image image-class="dock-img" src="/assets/icons/me.svg" mode="aspectFit" preview-local /></view>
        <text>我的</text>
      </view>
    </view>
  </view>
</view>

<!-- 写字：输入栏贴着键盘 -->
<view wx:else class="ink-bar" style="bottom:{{kb}}px;padding-bottom:{{kb ? 0 : safeBottom}}px">
  <text class="ink-date">{{ink.title}}</text>
  <input
    class="ink-in"
    value="{{ink.value}}"
    focus
    maxlength="40"
    placeholder="写点什么"
    placeholder-class="ink-ph"
    confirm-type="done"
    adjust-position="{{false}}"
    bindinput="onInk"
    bindconfirm="endInk"
    bindblur="endInk"
    bindkeyboardheightchange="onKeyboard"
  />
  <view class="ink-btn line" catchtouchstart="openDay">日页</view>
  <view class="ink-btn" catchtouchstart="endInk">好了</view>
</view>
