/* 与 WebGL 桌面共用底色。尺寸用 px 与画布边界对齐。 */
page {
  height: 100%;
  overflow: hidden;
  background: #E9EBE4;
  color: #283B32;
}

.top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #E9EBE4;
}
.masthead {
  position: absolute;
  left: 20px;
  height: 32px;
  display: flex;
  align-items: center;
}
.masthead-mark {
  width: 29px;
  height: 29px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: #29483A;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26);
}
.masthead-mark image {
  width: 17px;
  height: 17px;
}
.masthead-name {
  margin-left: 8px;
  font-size: 19px;
  font-weight: 600;
  letter-spacing: 0.7px;
  line-height: 1.2;
}
.masthead-status {
  margin-left: 12px;
  font-size: 12px;
  color: #59665E;
}

.gl {
  position: fixed;
  left: 0;
  width: 100vw;
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #E9EBE4;
}
.month-rail,
.dock,
.tray {
  max-width: 440px;
  margin-left: auto;
  margin-right: auto;
  width: calc(100% - 36px);
}
.month-rail {
  height: 44px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.rail-side {
  flex: 0 0 48px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  font-size: 13px;
  color: #536258;
  border-radius: 12px;
}
.rail-today {
  color: #325B46;
  font-weight: 500;
}
.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #283B32;
}
.month-label {
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-width: 94px;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.25;
}
.month-number,
.month-year {
  font-family: var(--numerals);
  font-variant-numeric: tabular-nums;
}
.month-number {
  margin-right: 2px;
  font-size: 20px;
}
.month-year {
  margin-left: 9px;
  color: #59665E;
  font-size: 12px;
}
.month-arrow {
  width: 40px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
}
.month-arrow .chev,
.open-book .chev {
  width: 7px;
  height: 7px;
  border-width: 1.5px;
  border-color: #56635A;
}
.open-book {
  height: 38px;
  margin: 0 auto;
  padding: 0 17px;
  display: flex;
  align-items: center;
  border-radius: 11px;
  border: 1px solid #CFD9CD;
  background: #F5F7F0;
  color: #29483A;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.25px;
}
.open-book .chev {
  margin-left: 9px;
}
.dock {
  height: 62px;
  margin-top: 3px;
  padding: 4px 6px;
  display: flex;
  align-items: stretch;
  border-radius: 21px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  background: linear-gradient(165deg, #FBFCF7, #F0F3EA);
  box-shadow: 0 1px 2px rgba(41, 58, 47, 0.08), 0 5px 14px rgba(41, 58, 47, 0.09);
}
.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-width: 0;
  border-radius: 15px;
  color: #56635A;
  font-size: 12px;
  font-weight: 500;
  line-height: 16px;
}
.dock-icon {
  width: 39px;
  height: 28px;
  margin-bottom: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
}
.dock-icon image {
  width: 21px;
  height: 21px;
}
.dock-item.is-active {
  color: #29483A;
}
.is-active .dock-icon {
  background: linear-gradient(150deg, #3D6551, #29483A);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24), 0 2px 4px rgba(42, 73, 57, 0.15);
}
.control-pressed {
  background: rgba(53, 85, 66, 0.1);
}

/* 贴纸夹：分类像夹页标签，贴纸在半透明的口袋里。 */
.tray {
  height: 130px;
  margin-bottom: 7px;
  padding: 5px 7px 7px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 17px;
  background: linear-gradient(150deg, #FCFCF7, #EEF2E8);
  box-shadow: 0 3px 9px rgba(41, 58, 47, 0.1);
}
.tray-tabs {
  display: flex;
  height: 32px;
  padding: 0 2px;
}
.tray-tab {
  flex: 1;
  height: 32px;
  line-height: 32px;
  text-align: center;
  border-radius: 8px 8px 0 0;
  font-size: 12px;
  color: #536258;
}
.tray-tab.on {
  color: #29483A;
  font-weight: 500;
  background: #E2E9DF;
}
.tray-items {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  height: 84px;
  border-radius: 4px 4px 11px 11px;
  background: linear-gradient(172deg, #E3EBDF 0%, #F7F8F2 48%, #F0F3EA 82%, #F9FAF5 100%);
  box-shadow: inset 0 1px 0 rgba(70, 97, 78, 0.12), inset 0 -1px 0 #FFF;
}
.tray-item {
  width: 16.666%;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tray-item.wide {
  width: 25%;
}
.tray-item-hover {
  transform: scale(0.88);
  opacity: 0.7;
}
.tray-img {
  width: 39px;
  height: 39px;
  filter: drop-shadow(0 1px 1px rgba(43, 55, 44, 0.24));
}
.tray-item.wide .tray-img {
  width: 90%;
  height: 38px;
}
.tray-tape {
  width: 82%;
  height: 17px;
  opacity: 0.92;
  transform: rotate(-2deg);
}

/* 第一次打开的同意卡片 */
.consent {
  width: calc(100% - 24px);
  max-width: 440px;
  margin: 8px auto 0;
  padding: 14px 16px 10px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  background: #F8F9F2;
  box-shadow: 0 4px 16px rgba(41, 58, 47, 0.1);
}
.c-t {
  display: block;
  font-size: 17px;
  font-weight: 600;
  color: #30533A;
}
.c-p {
  margin-top: 6px;
  font-size: 13px;
  line-height: 20px;
  color: #536258;
}
.c-a {
  color: #A35648;
}
.c-btns {
  display: flex;
  margin-top: 12px;
}
.c-btn {
  flex: 1;
  height: 40px !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 40px !important;
  border-radius: 20px !important;
  font-size: 14px !important;
  font-weight: 600 !important;
}
.c-btn::after {
  border: 0;
}
.c-no {
  width: auto !important;
  margin-right: 10px !important;
  color: #536258 !important;
  background: #E9EDE3 !important;
}
.c-ok {
  width: auto !important;
  color: #FCF0DA !important;
  background: #30533A !important;
}
.c-s {
  display: block;
  margin-top: 8px;
  text-align: center;
  font-size: 11px;
  color: #667267;
}

/* 写字时的输入栏 */
.ink-bar {
  position: fixed;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: 54px;
  box-sizing: content-box;
  padding: 0 12px;
  background: #F8F9F2;
  border-top: 1px solid #D7DFD3;
}
.ink-date {
  flex-shrink: 0;
  margin-right: 10px;
  font-size: 14px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  color: #A35648;
}
.ink-in {
  flex: 1;
  min-width: 0;
  height: 38px;
  padding: 0 12px;
  border-radius: 10px;
  font-family: var(--sans);
  font-size: 16px;
  color: #2F4F66;
  background: #EAEEE4;
}
.ink-ph {
  color: #697669;
}
.ink-btn {
  flex-shrink: 0;
  margin-left: 8px;
  height: 34px;
  padding: 0 14px;
  line-height: 34px;
  border-radius: 17px;
  font-size: 13px;
  color: #FCF0DA;
  background: #30533A;
}
.ink-btn.line {
  line-height: 32px;
  color: #30533A;
  background: transparent;
  border: 1px solid #30533A;
}
