/* 与 WebGL 桌面共用底色。尺寸用 px 与画布边界对齐。 */
page {
  height: 100%;
  overflow: hidden;
  background: var(--desk);
  color: var(--ink);
}

.top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: var(--desk);
}
.masthead {
  position: absolute;
  left: 20px;
  height: 32px;
  display: flex;
  align-items: center;
}
.masthead-mark {
  width: 29px;
  height: 29px;
  border-radius: 9px;
  flex-shrink: 0;
}
.masthead-name {
  margin-left: 8px;
  font-size: 19px;
  font-weight: 600;
  letter-spacing: 0.7px;
  line-height: 1.2;
}
.masthead-status {
  margin-left: 12px;
  font-size: 12px;
  color: #595959;
}

.gl {
  position: fixed;
  left: 0;
  width: 100vw;
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--desk);
}
.menu-layout {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding-bottom: 9px;
}
.menu-panels {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 0;
  overflow: hidden;
}
.menu-layout .month-rail,
.menu-layout .dock,
.menu-panels .tray,
.menu-panels .drawing-tools {
  flex-shrink: 0;
}
.month-rail,
.dock,
.tray,
.drawing-tools,
.ink-palette {
  max-width: 440px;
  margin-left: auto;
  margin-right: auto;
  width: calc(100% - 36px);
}
.month-rail {
  height: 44px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.rail-side {
  flex: 0 0 48px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  font-size: 13px;
  color: #555555;
  border-radius: 12px;
}
.rail-today {
  color: #353535;
  font-weight: 500;
}
.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #202020;
}
.month-label {
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-width: 94px;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.25;
}
.month-number,
.month-year {
  font-family: var(--numerals);
  font-variant-numeric: tabular-nums;
}
.month-number {
  margin-right: 2px;
  font-size: 20px;
}
.month-year {
  margin-left: 9px;
  color: #595959;
  font-size: 12px;
}
.month-arrow {
  width: 40px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
}
.month-arrow .chev,
.open-book .chev {
  width: 7px;
  height: 7px;
  border-width: 1.5px;
  border-color: #303030;
}
.open-book {
  height: 38px;
  margin: 0 auto;
  padding: 0 17px;
  display: flex;
  align-items: center;
  border-radius: 11px;
  border: 1px solid #CDCDCD;
  background: #F8F8F8;
  color: #262626;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.25px;
}
.open-book .chev {
  margin-left: 9px;
}
.dock {
  height: 62px;
  margin-top: 3px;
  padding: 4px 6px;
  display: flex;
  align-items: stretch;
  border-radius: 21px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  background: #FAFAFA;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 5px 14px rgba(0, 0, 0, 0.08);
}
.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-width: 0;
  border-radius: 15px;
  color: #555;
  font-size: 12px;
  font-weight: 500;
  line-height: 16px;
}
.dock-icon {
  width: 39px;
  height: 28px;
  margin-bottom: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
}
.dock-img {
  width: 21px;
  height: 21px;
}
.dock-item.is-active { color: #141414; }
.is-active .dock-icon {
  background: #141414;
}
.is-active .dock-img {
  filter: brightness(0) invert(1);
}
.control-pressed {
  background: rgba(20, 20, 20, 0.1);
}

.drawing-tools {
  height: 93px;
  margin-bottom: 5px;
  padding: 4px 7px;
  border: 1px solid rgba(255, 255, 255, 0.95);
  border-radius: 17px;
  background: #FAFAFA;
  box-shadow: 0 3px 9px rgba(0, 0, 0, 0.09);
}
.drawing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.drawing-primary {
  height: 44px;
}
.drawing-pens,
.drawing-actions {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  align-items: center;
  justify-content: space-around;
}
.drawing-actions {
  margin-left: auto;
  border-left: 1px solid #E4E4E4;
  padding-left: 3px;
}
.drawing-key {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  max-width: 44px;
  height: 44px;
  min-width: 0;
  border-radius: 11px;
}
.drawing-glyph {
  position: relative;
  display: block;
  width: 23px;
  height: 23px;
}
.drawing-redo {
  transform: scaleX(-1);
}
.drawing-key.chosen::before {
  content: '';
  position: absolute;
  top: 5px;
  bottom: 5px;
  left: 2px;
  right: 2px;
  border-radius: 10px;
  background: #141414;
}
.drawing-key.chosen .drawing-glyph {
  filter: brightness(0) invert(1);
}
.drawing-pressed {
  opacity: 0.68;
}
.drawing-options {
  height: 39px;
  border-top: 1px solid #E4E4E4;
}
.ink-colors,
.ink-weights {
  display: flex;
  align-items: center;
}
.ink-colors {
  min-width: 0;
}
.ink-weights {
  gap: 2px;
}
.swatch {
  width: 32px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.swatch-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--swatch);
}
.swatch.picked .swatch-dot {
  box-shadow: 0 0 0 1.5px #FAFAFA, 0 0 0 3px #141414;
}
.palette-glyph {
  width: 23px;
  height: 23px;
}
.size-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 8px;
}
.size-btn.chosen {
  background: #E9E9E9;
}
.weight-mark {
  width: 17px;
  border-radius: 4px;
  background: #141414;
}
.dimmed {
  opacity: 0.45;
}

@media (max-width: 340px) {
  .drawing-glyph { width: 20px; height: 20px; }
  .swatch, .size-btn { width: 26px; }
}

.ink-palette {
  height: 228px;
  padding: 10px 12px;
  border: 1px solid #FFF;
  border-radius: 17px;
  background: #FAFAFA;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.13);
}
.palette-heading,
.palette-footer {
  display: flex;
  align-items: center;
  gap: 8px;
}
.palette-heading {
  height: 26px;
}
.palette-title {
  margin-right: auto;
  color: #262626;
  font-size: 14px;
  font-weight: 600;
}
.palette-preview {
  width: 18px;
  height: 18px;
  border: 1px solid rgba(0, 0, 0, 0.18);
  border-radius: 50%;
}
.palette-hex {
  color: #555555;
  font-family: monospace;
  font-size: 12px;
}
.palette-field {
  position: relative;
  height: 104px;
  margin: 6px 8px 0;
  border-radius: 8px;
  background-image: linear-gradient(to top, #000, transparent), linear-gradient(to right, #FFF, transparent);
}
.palette-cursor {
  position: absolute;
  width: 16px;
  height: 16px;
  border: 2px solid #FFF;
  border-radius: 50%;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.45);
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.palette-hue {
  position: relative;
  height: 36px;
}
.palette-hue::before {
  position: absolute;
  content: '';
  top: 13px;
  right: 8px;
  left: 8px;
  height: 10px;
  border-radius: 5px;
  background: linear-gradient(90deg, #F00, #FF0, #0F0, #0FF, #00F, #F0F, #F00);
  pointer-events: none;
}
.palette-hue slider {
  position: relative;
  height: 36px;
  margin: 0 8px;
}
.palette-cancel,
.palette-apply {
  flex: 1 1 0;
  width: auto;
  margin: 0;
  padding: 0;
  border-radius: 9px;
  line-height: 33px;
  font-size: 13px;
}
.palette-cancel {
  color: #303030;
  background: #EAEAEA;
}
.palette-apply {
  color: #FFFFFF;
  background: #303030;
}
.palette-cancel::after,
.palette-apply::after {
  border: 0;
}

/* 贴纸夹：分类像夹页标签，贴纸在半透明的口袋里。 */
.tray {
  height: 157px;
  margin-bottom: 7px;
  padding: 5px 7px 7px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 17px;
  background: linear-gradient(150deg, #FCFCFC, #F0F0F0);
  box-shadow: 0 3px 9px rgba(0, 0, 0, 0.1);
}
.tray-tabs {
  display: flex;
  height: 32px;
  padding: 0 2px;
}
.tray-tab {
  flex: 1;
  height: 32px;
  line-height: 32px;
  text-align: center;
  border-radius: 8px 8px 0 0;
  font-size: 12px;
  color: #555555;
}
.tray-tab.on {
  color: #262626;
  font-weight: 500;
  background: #E4E4E4;
}
.tray-items {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  height: 84px;
  border-radius: 4px 4px 11px 11px;
  background: linear-gradient(172deg, #E5E5E5 0%, #F7F7F7 48%, #F2F2F2 82%, #FAFAFA 100%);
  box-shadow: inset 0 1px 0 rgba(20, 20, 20, 0.12), inset 0 -1px 0 #FFF;
}
.tray-item {
  width: 16.666%;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tray-item.wide {
  width: 25%;
}
.tray-item-hover {
  transform: scale(0.88);
  opacity: 0.7;
}
.tray-img {
  width: 39px;
  height: 39px;
  filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.24));
}
.tray-item.wide .tray-img {
  width: 90%;
  height: 38px;
}
.tray-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 27px;
  font-family: var(--numerals);
  font-size: 11px;
  color: #555555;
}
.tray-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 27px;
}
.tray-arrow .chev {
  width: 6px;
  height: 6px;
  border-width: 1.5px;
}
.tray-arrow.muted {
  opacity: 0.3;
}
.tray-tape {
  width: 82%;
  height: 17px;
  opacity: 0.92;
  transform: rotate(-2deg);
}

/* 第一次打开的同意卡片 */
.consent {
  width: calc(100% - 24px);
  max-width: 440px;
  margin: 8px auto 0;
  padding: 14px 16px 10px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  background: #FAFAFA;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
}
.c-t {
  display: block;
  font-size: 17px;
  font-weight: 600;
  color: #262626;
}
.c-p {
  margin-top: 6px;
  font-size: 13px;
  line-height: 20px;
  color: #555555;
}
.c-a {
  color: #424242;
}
.c-btns {
  display: flex;
  margin-top: 12px;
}
.c-btn {
  flex: 1;
  height: 40px !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 40px !important;
  border-radius: 20px !important;
  font-size: 14px !important;
  font-weight: 600 !important;
}
.c-btn::after {
  border: 0;
}
.c-no {
  width: auto !important;
  margin-right: 10px !important;
  color: #555555 !important;
  background: #EAEAEA !important;
}
.c-ok {
  width: auto !important;
  color: #FAFAFA !important;
  background: #262626 !important;
}
.c-s {
  display: block;
  margin-top: 8px;
  text-align: center;
  font-size: 11px;
  color: #666666;
}

/* 写字时的输入栏 */
.ink-bar {
  position: fixed;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: 54px;
  box-sizing: content-box;
  padding: 0 12px;
  background: #FAFAFA;
  border-top: 1px solid #D8D8D8;
}
.ink-date {
  flex-shrink: 0;
  margin-right: 10px;
  font-size: 14px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  color: #424242;
}
.ink-in {
  flex: 1;
  min-width: 0;
  height: 38px;
  padding: 0 12px;
  border-radius: 10px;
  font-family: var(--sans);
  font-size: 16px;
  color: #303030;
  background: #ECECEC;
}
.ink-ph {
  color: #676767;
}
.ink-btn {
  flex-shrink: 0;
  margin-left: 8px;
  height: 34px;
  padding: 0 14px;
  line-height: 34px;
  border-radius: 17px;
  font-size: 13px;
  color: #FAFAFA;
  background: #262626;
}
.ink-btn.line {
  line-height: 32px;
  color: #262626;
  background: transparent;
  border: 1px solid #262626;
}
