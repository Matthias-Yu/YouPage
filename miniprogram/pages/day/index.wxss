.wrap {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(190rpx + env(safe-area-inset-bottom));
}

/* 纸页：右下角折一个角 */
.page-paper {
  position: relative;
  min-height: calc(100vh - 230rpx - env(safe-area-inset-bottom));
  padding: 36rpx 36rpx 90rpx;
  border-bottom-right-radius: 0;
}
.page-paper::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(315deg, var(--desk) 50%, #EAD5AE 50%);
  border-top-left-radius: 14rpx;
  box-shadow: -4rpx -4rpx 10rpx rgba(96, 66, 28, 0.08);
}
.deco {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

/* 页眉 */
.hd {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 3rpx solid var(--ink);
}
.hd-d {
  min-width: 96rpx;
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1;
  color: var(--ink);
}
.hd-d.today {
  color: var(--terra);
}
.hd-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 3rpx solid var(--ink);
}
.hd-en {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--ink);
}
.hd-lu {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}
.hd-fest {
  color: var(--terra);
}
.stamps {
  display: flex;
}
.stamp {
  width: 84rpx;
  height: 84rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--line-2);
}
.stamp.filled {
  border-color: transparent;
}
.stamp-img {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 2rpx 4rpx rgba(80, 56, 24, 0.22));
}
.stamp-ph {
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 月历格子里的那一句 */
.plan {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 20rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: var(--paper-hi);
  border: 2rpx dashed var(--line-2);
}
.plan-l {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 0 12rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--paper);
  background: var(--green);
}
.plan-in {
  flex: 1;
  height: 80rpx;
  font-family: var(--hand);
  font-size: 30rpx;
  color: #2F4F66;
}

/* 分区 */
.sec {
  margin-top: 36rpx;
}
.sec-t {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--green);
}
.sec-n {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
}

/* 待办 */
.todo {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  border-bottom: 2rpx solid var(--line);
}
.chk {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 3rpx solid var(--green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chk.ghost {
  border-style: dashed;
  border-color: var(--line-2);
}
.chk-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--terra);
  transform: scale(0);
  transition: transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1);
}
.todo.done .chk {
  border-color: var(--terra);
}
.todo.done .chk-dot {
  transform: scale(1);
}
.todo-in {
  flex: 1;
  height: 80rpx;
  font-family: var(--hand);
  font-size: 32rpx;
  color: var(--ink);
}
.todo.done .todo-in {
  color: var(--ink-3);
  text-decoration: line-through;
}
.ph {
  color: var(--ink-3);
}

/* 随手记：横线纸 */
.note {
  width: 100%;
  min-height: 360rpx;
  font-family: var(--hand);
  font-size: 32rpx;
  line-height: 60rpx;
  color: var(--ink);
  background-image: repeating-linear-gradient(transparent, transparent 58rpx, var(--line) 58rpx, var(--line) 60rpx);
}

/* 工具栏 */
.bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 20rpx;
  background: var(--paper-hi);
  border-radius: 56rpx;
  box-shadow: 0 8rpx 28rpx rgba(96, 66, 28, 0.2);
}
.tools {
  display: flex;
}
.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
  font-size: 20rpx;
  color: var(--ink-2);
}
.tool:active {
  opacity: 0.6;
}
.tool-ic {
  width: 48rpx;
  height: 48rpx;
}

/* 心情 / 天气选项 */
.opts {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 12rpx;
}
.opt {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
  border-radius: 20rpx;
}
.opt.on {
  background: var(--green-wash);
}
.opt-img {
  width: 104rpx;
  height: 104rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(80, 56, 24, 0.22));
}
.opt-tx {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

/* 贴纸抽屉 */
.packs {
  display: flex;
  margin-bottom: 16rpx;
}
.pack {
  position: relative;
  margin-right: 12rpx;
  padding: 0 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.pack.on {
  color: var(--paper);
  background: var(--green);
}
.pack-tag {
  position: absolute;
  right: -8rpx;
  top: -12rpx;
}
.grid-scroll {
  height: 520rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
}
.cell {
  width: 25%;
  height: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell.wide {
  width: 50%;
  height: 132rpx;
}
.cell:active {
  background: var(--green-wash);
  border-radius: 20rpx;
}
.cell-img {
  width: 132rpx;
  height: 132rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(80, 56, 24, 0.22));
}
.cell.wide .cell-img {
  width: 232rpx;
  height: 116rpx;
}

/* 胶带抽屉 */
.tapes {
  padding-bottom: 8rpx;
}
.tape-row {
  display: flex;
  align-items: center;
  height: 92rpx;
}
.tape-row:active {
  opacity: 0.6;
}
.tape-demo {
  flex: 1;
  height: 52rpx;
  opacity: 0.92;
  transform: rotate(-1deg);
}
.tape-name {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-2);
}
