page {
  --desk: #E9EBE4;
  --paper: #FCF9EF;
  --paper-hi: #FFFDF5;
  --line: #D6DBCF;
  --line-2: #B9C3B3;
  --terra: #A35648;
  --ink-2: #59665E;
  --ink-3: #687369;
}

.wrap {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(190rpx + env(safe-area-inset-bottom));
}

/* 纸页：右下角折一个角 */
.page-paper {
  position: relative;
  min-height: calc(100vh - 230rpx - env(safe-area-inset-bottom));
  padding: 36rpx 36rpx 90rpx;
  background: linear-gradient(110deg, #EBEADF, #FFFDF5 9%, #FCF9EF 76%, #F7F3E7);
  border-radius: 10rpx;
  border-bottom-right-radius: 0;
  box-shadow: inset 0 0 0 1rpx #FFFDF8, 0 3rpx 0 #D9DDCF, 0 6rpx 0 #F8F6E9, 0 12rpx 26rpx rgba(41, 58, 47, 0.13);
}
.page-paper::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(315deg, var(--desk) 49%, #D0D7C6 50%, #E8EADB 66%, #FCF9EF 90%);
}
.deco {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

/* 页眉 */
.hd {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--line-2);
}
.hd-d {
  min-width: 96rpx;
  font-family: var(--numerals);
  font-size: 86rpx;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: var(--ink);
}
.hd-d.today {
  color: var(--terra);
}
.hd-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 14rpx;
  padding-left: 18rpx;
  border-left: 2rpx solid var(--line-2);
}
.hd-en {
  font-family: var(--editorial);
  font-size: 33rpx;
  font-style: italic;
  line-height: 1.2;
  color: var(--ink);
}
.hd-lu {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: var(--ink-2);
}
.hd-fest {
  color: var(--terra);
}
.stamps {
  display: flex;
  flex-shrink: 0;
}
.stamp {
  width: 84rpx;
  height: 84rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--line-2);
}
.stamp.filled {
  border-color: transparent;
}
.stamp-img {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 2rpx 4rpx rgba(80, 56, 24, 0.22));
}
.stamp-ph {
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 月历格子里的那一句 */
.plan {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 20rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: rgba(223, 232, 219, 0.46);
  border: 1rpx solid var(--line);
}
.plan-l {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 0 12rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--green-deep);
  background: #DCE7D9;
}
.plan-in {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-family: var(--sans);
  font-size: 30rpx;
  color: #2F4F66;
}

/* 分区 */
.sec {
  margin-top: 36rpx;
}
.sec-t {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: var(--green);
}
.sec-n {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
}

/* 待办 */
.todo {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  border-bottom: 2rpx solid var(--line);
}
.chk {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 3rpx solid var(--green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chk.ghost {
  border-style: dashed;
  border-color: var(--line-2);
}
.chk-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--terra);
  transform: scale(0);
  transition: transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1);
}
.todo.done .chk {
  border-color: var(--terra);
}
.todo.done .chk-dot {
  transform: scale(1);
}
.todo-in {
  flex: 1;
  height: 80rpx;
  font-family: var(--sans);
  font-size: 32rpx;
  color: var(--ink);
}
.todo.done .todo-in {
  color: var(--ink-3);
  text-decoration: line-through;
}
.ph {
  color: var(--ink-3);
}

/* 随手记：横线纸 */
.note {
  width: 100%;
  min-height: 360rpx;
  font-family: var(--sans);
  font-size: 32rpx;
  line-height: 60rpx;
  color: var(--ink);
  background-image: repeating-linear-gradient(transparent, transparent 58rpx, var(--line) 58rpx, var(--line) 60rpx);
}

/* 工具栏 */
.bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 20rpx;
  background: linear-gradient(165deg, #FBFCF7, #F0F3EA);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  box-shadow: 0 3rpx 5rpx rgba(41, 58, 47, 0.08), 0 8rpx 24rpx rgba(41, 58, 47, 0.12);
}
.tools {
  display: flex;
  flex: 1;
}
.tool {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 96rpx;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink-2);
}
.tool:active {
  opacity: 0.6;
}
.tool-ic {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 3rpx;
}
.bar .round-btn {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* 心情 / 天气选项 */
.opts {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 12rpx;
}
.opt {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
  border-radius: 20rpx;
}
.opt.on {
  background: var(--green-wash);
}
.opt-img {
  width: 104rpx;
  height: 104rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(80, 56, 24, 0.22));
}
.opt-tx {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

/* 贴纸抽屉 */
.packs {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.pack {
  position: relative;
  flex: 1;
  min-width: 0;
  margin: 0 4rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-2);
}
.pack.on {
  color: var(--paper);
  background: var(--green);
}
.pack-tag {
  position: absolute;
  right: 0;
  top: -12rpx;
}
.grid-scroll {
  height: 520rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
}
.cell {
  width: 25%;
  height: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell.wide {
  width: 50%;
  height: 132rpx;
}
.cell:active {
  background: var(--green-wash);
  border-radius: 20rpx;
}
.cell-img {
  width: 132rpx;
  height: 132rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(80, 56, 24, 0.22));
}
.cell.wide .cell-img {
  width: 232rpx;
  height: 116rpx;
}

/* 胶带抽屉 */
.tapes {
  padding-bottom: 8rpx;
}
.tape-row {
  display: flex;
  align-items: center;
  height: 92rpx;
}
.tape-row:active {
  opacity: 0.6;
}
.tape-demo {
  flex: 1;
  height: 52rpx;
  opacity: 0.92;
  transform: rotate(-1deg);
}
.tape-name {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-2);
}
