.page {
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.hd {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 20rpx 8rpx 24rpx;
}
.hd-l {
  display: flex;
  flex-direction: column;
}
.h1 {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.2;
  color: var(--ink);
}
.h-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.mon {
  display: flex;
  align-items: center;
}
.mon-t {
  min-width: 132rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

/* 集章卡 */
.card {
  margin-bottom: 24rpx;
  padding: 26rpx 24rpx 20rpx;
}
.card-hd {
  display: flex;
  align-items: center;
}
.h-ic {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.22));
}
.h-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 14rpx;
}
.h-name {
  font-family: var(--serif);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.h-meta {
  font-size: 22rpx;
  color: var(--ink-3);
}
.seal-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 30rpx;
  line-height: 60rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--emphasis);
  border: 2rpx solid var(--emphasis);
}
.seal-btn.on {
  color: var(--paper);
  background: var(--emphasis);
}
/* 每行 8 个 */
.dots {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  justify-items: center;
  row-gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line-2);
}
.dot {
  width: 62rpx;
  height: 62rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 50%;
  font-family: var(--serif);
  font-size: 24rpx;
  color: var(--ink-2);
  border: 2rpx solid var(--line-2);
  transition: background 0.15s, transform 0.15s;
}
.dot.today {
  border-color: var(--emphasis);
  color: var(--emphasis);
  font-weight: 700;
}
.dot.future {
  border-style: dashed;
  color: var(--line-2);
}
.dot.on {
  color: var(--paper);
  font-weight: 700;
  background: var(--emphasis);
  border-color: var(--emphasis);
  transform: rotate(-8deg);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
}
.empty-img {
  width: 168rpx;
  height: 168rpx;
  opacity: 0.85;
}
.empty-t {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.empty-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.add {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--accent);
  border: 3rpx dashed var(--accent-soft);
}
.add:active {
  background: rgba(26, 26, 26, 0.06);
}
.add-plus {
  margin-right: 8rpx;
  font-size: 34rpx;
  line-height: 1;
}
.tip {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 新建抽屉 */
.field {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: var(--paper-hi);
  border: 2rpx solid var(--line);
}
.field-ic {
  width: 72rpx;
  height: 72rpx;
}
.field-in {
  flex: 1;
  height: 100rpx;
  margin-left: 12rpx;
  font-size: 32rpx;
  color: var(--ink);
}
.ph {
  color: var(--ink-3);
}
.presets {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.preset {
  margin: 0 12rpx 12rpx 0;
}
.icons {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx 0 24rpx;
}
.icon {
  width: 20%;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}
.icon.on {
  background: var(--accent-wash);
}
.icon-img {
  width: 92rpx;
  height: 92rpx;
}
