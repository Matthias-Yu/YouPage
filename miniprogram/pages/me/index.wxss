.page {
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.brand {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 28rpx;
}
.brand-logo {
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-control);
  flex-shrink: 0;
}
.brand-tx {
  display: flex;
  flex-direction: column;
}
.brand-name {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1.4rpx;
  line-height: 1.2;
  color: var(--accent);
}
.brand-slogan {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.stats {
  display: flex;
  padding: 30rpx 0;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx solid var(--line);
}
.stat:last-child {
  border-right: 0;
}
.stat-n {
  font-family: var(--numerals);
  font-variant-numeric: tabular-nums;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1.15;
  color: var(--ink);
}
.stat-l {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 会员卡 */
.vip {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 28rpx;
}
.vip-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.vip-t {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}
.vip-s {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--ink-2);
}
.vip-go {
  flex-shrink: 0;
  margin-left: 20rpx;
  height: 60rpx;
  padding: 0 28rpx;
  line-height: 60rpx;
  border-radius: var(--radius-control);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--paper);
  background: var(--accent);
}

.list {
  margin-top: 24rpx;
  padding: 0 28rpx;
}
.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 2rpx solid var(--line);
}
.row:last-child {
  border-bottom: 0;
}
.row-t {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}
.row-t.danger {
  color: var(--emphasis);
}
.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 18rpx 0;
}
.row-s {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--ink-3);
}
.row-s.warn {
  color: var(--emphasis);
}
.row-v {
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}
/* 把 button 还原成普通行（style v2 的按钮有固定宽度和内边距，需要压过去） */
.row-btn {
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  text-align: left;
  font-weight: 400 !important;
  line-height: 1.5;
  background: transparent !important;
  border-radius: 0;
}
.row-btn::after {
  border: 0;
}
.note {
  display: block;
  margin: 16rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--ink-3);
}
