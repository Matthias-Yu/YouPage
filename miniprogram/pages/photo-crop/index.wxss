page {
  height: 100%;
  background: #EBEBEB;
  color: #202020;
}

.editor {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
}

.mode,
.mask-choice,
.reset,
.secondary,
.primary {
  margin: 0;
  padding: 0;
  color: inherit;
  font-size: 26rpx;
  font-weight: 500;
  background: transparent;
}

.mode::after,
.mask-choice::after,
.reset::after,
.secondary::after,
.primary::after {
  border: 0;
}

.modes {
  display: flex;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #E0E0E0;
}

.mode {
  flex: 1;
  min-width: 0;
  line-height: 68rpx;
  border-radius: 15rpx;
  color: #555555;
}

.mode.selected {
  color: #262626;
  background: #FAFAFA;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.13);
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  margin-top: 22rpx;
  overflow: hidden;
  border: 1rpx solid #CDCDCD;
  border-radius: 22rpx;
  background: #DFDFDF;
}

.preview {
  display: block;
  width: 100%;
  height: 100%;
}

.loading {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  text-align: center;
  transform: translateY(-50%);
  color: #555555;
  font-size: 26rpx;
}

.adjustments {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 122rpx;
}

.adjustments.mask-controls {
  height: 190rpx;
}

.hint {
  color: #555555;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.reset {
  padding: 0 26rpx;
  color: #424242;
  line-height: 56rpx;
}

.masks {
  display: flex;
  width: 100%;
  gap: 12rpx;
}

.mask-choice {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  gap: 6rpx;
  border-radius: 14rpx;
  line-height: 60rpx;
  font-size: 23rpx;
  color: #303030;
  background: #F6F6F6;
}

.mask-choice.selected {
  color: #141414;
  background: #FFF;
  box-shadow: inset 0 0 0 2rpx #141414;
}

.mask-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.size-control {
  display: flex;
  align-items: center;
  width: 100%;
  padding-left: 14rpx;
  color: #555555;
  font-size: 23rpx;
}

.size-control slider {
  flex: 1;
  margin: 14rpx 20rpx;
}

.actions {
  display: flex;
  gap: 12rpx;
}

.secondary,
.primary {
  width: auto;
  line-height: 80rpx;
  border-radius: 17rpx;
  white-space: nowrap;
}

.secondary {
  padding: 0 22rpx;
  background: #F8F8F8;
}

.primary {
  flex: 1 0 auto;
  min-width: 0;
  padding: 0 18rpx;
  color: #FFFFFF;
  background: #262626;
}

.primary.unavailable {
  color: #646464;
  background: #DEDEDE;
}

.export {
  position: absolute;
  left: -10000px;
  top: 0;
  width: 1px;
  height: 1px;
}
