page {
  height: 100%;
  background: #E9EBE4;
  color: #283B32;
}

.editor {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
}

.mode,
.mask-choice,
.reset,
.secondary,
.primary {
  margin: 0;
  padding: 0;
  color: inherit;
  font-size: 26rpx;
  font-weight: 500;
  background: transparent;
}

.mode::after,
.mask-choice::after,
.reset::after,
.secondary::after,
.primary::after {
  border: 0;
}

.modes {
  display: flex;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #DBE2D9;
}

.mode {
  flex: 1;
  min-width: 0;
  line-height: 68rpx;
  border-radius: 15rpx;
  color: #536258;
}

.mode.selected,
.mask-choice.selected {
  color: #29483A;
  background: #F7F8F1;
  box-shadow: 0 2rpx 5rpx rgba(41, 59, 46, 0.13);
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  margin-top: 22rpx;
  overflow: hidden;
  border: 1rpx solid #CDD7CB;
  border-radius: 22rpx;
  background: #DFE5DC;
}

.preview {
  display: block;
  width: 100%;
  height: 100%;
}

.loading {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  text-align: center;
  transform: translateY(-50%);
  color: #536258;
  font-size: 26rpx;
}

.adjustments {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 122rpx;
}

.adjustments.mask-controls {
  height: 190rpx;
}

.hint {
  color: #536258;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.reset {
  padding: 0 26rpx;
  color: #A35648;
  line-height: 56rpx;
}

.masks {
  display: flex;
  width: 100%;
  gap: 12rpx;
}

.mask-choice {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  gap: 6rpx;
  border-radius: 14rpx;
  line-height: 60rpx;
  font-size: 23rpx;
  background: #DFE6DC;
}

.mask-icon {
  font-size: 32rpx;
  font-weight: 400;
}

.size-control {
  display: flex;
  align-items: center;
  width: 100%;
  padding-left: 14rpx;
  color: #536258;
  font-size: 23rpx;
}

.size-control slider {
  flex: 1;
  margin: 14rpx 20rpx;
}

.actions {
  display: flex;
  gap: 12rpx;
}

.secondary,
.primary {
  width: auto;
  line-height: 80rpx;
  border-radius: 17rpx;
  white-space: nowrap;
}

.secondary {
  padding: 0 22rpx;
  background: #F5F7F0;
}

.primary {
  flex: 1 0 auto;
  min-width: 0;
  padding: 0 18rpx;
  color: #FFF8E6;
  background: #30533A;
}

.primary.unavailable {
  color: #67766A;
  background: #DDE4DB;
}

.export {
  position: absolute;
  left: -10000px;
  top: 0;
  width: 1px;
  height: 1px;
}
