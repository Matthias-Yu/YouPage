.layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}
.el {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
}
.box {
  position: absolute;
  left: 0;
  top: 0;
  pointer-events: auto;
}

/* 贴纸 */
.art {
  display: block;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.25));
}

/* 胶带：半透明 + 锯齿撕口 */
.tape {
  width: 100%;
  height: 100%;
  opacity: 0.9;
  clip-path: polygon(0 0, 100% 0, 98.4% 12.5%, 100% 25%, 98.4% 37.5%, 100% 50%, 98.4% 62.5%, 100% 75%, 98.4% 87.5%, 100% 100%, 0 100%, 1.6% 87.5%, 0 75%, 1.6% 62.5%, 0 50%, 1.6% 37.5%, 0 25%, 1.6% 12.5%);
}

/* 照片：拍立得相纸 */
.photo {
  width: 100%;
  height: 100%;
  padding: 5% 5% 0;
  background: #FFFFFF;
  border-radius: 4rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.22);
}
.photo-img {
  display: block;
  width: 100%;
  height: 78%;
  background: #DEDEDE;
}

/* 选中态 */
.frame {
  position: absolute;
  left: -6rpx;
  top: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border: 2rpx dashed #262626;
  border-radius: 8rpx;
  pointer-events: none;
}
.grip {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.hd {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(20, 20, 20, 0.3);
}
.hd-del {
  left: -30rpx;
  top: -30rpx;
  background: #FFF;
  border: 2rpx solid #141414;
}
.hd-rot {
  right: -30rpx;
  bottom: -30rpx;
  background: #141414;
}
.hd-ic {
  width: 28rpx;
  height: 28rpx;
}
.x {
  position: relative;
  width: 22rpx;
  height: 22rpx;
}
.x::before,
.x::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: -2rpx;
  width: 4rpx;
  height: 26rpx;
  border-radius: 2rpx;
  background: #141414;
}
.x::before { transform: rotate(45deg); }
.x::after { transform: rotate(-45deg); }
